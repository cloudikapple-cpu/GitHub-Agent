# Copy to .env and fill in what you use. Everything here is optional.
# After editing, run: jarvis --doctor

# -- provider selection --------------------------------------------------
JARVIS_BACKEND=openai
# Fully custom endpoint without touching config.yaml:
# JARVIS_BACKEND=custom
# JARVIS_API_KIND=openai
# JARVIS_API_BASE=https://your-gateway.example.com/v1
# JARVIS_API_KEY=...
# JARVIS_MODEL=your-model

# -- built-in providers ---------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Local model through Ollama: free, private, offline.
#   ollama serve && ollama pull llama3.1
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1

# NVIDIA NIM (OpenAI-compatible cloud fallback for a local model)
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Groq: OpenAI-compatible chat *and* the fastest hosted Whisper.
# Free keys: https://console.groq.com/keys
GROQ_API_KEY=

# -- routing: local model first, cloud rescue ------------------------------
JARVIS_ROUTER=false
JARVIS_ROUTER_PRIMARY=ollama
JARVIS_ROUTER_FALLBACKS=nim
JARVIS_ROUTER_HEAVY=nim

# -- internet --------------------------------------------------------------
TAVILY_API_KEY=
JARVIS_SEARCH_PROVIDER=auto

# -- capabilities (kill switches) -----------------------------------------
JARVIS_ALLOW_SHELL=true
JARVIS_ALLOW_EXEC=true
JARVIS_ALLOW_DESKTOP=true
JARVIS_ALLOW_APP_MANAGEMENT=false
JARVIS_ALLOW_NETWORK=true
JARVIS_ALLOWED_ROOTS=
JARVIS_AUDIT_LOG=~/.jarvis/audit.log
JARVIS_DRY_RUN=false
JARVIS_SANDBOX=none

# -- subsystems ------------------------------------------------------------
JARVIS_KNOWLEDGE=true
JARVIS_SCHEDULER=true
# Alt+Shift is used rather than Ctrl+Alt: Windows reserves several Ctrl+Alt
# combinations and Ctrl+Alt+Space is taken by some input methods.
JARVIS_HOTKEY=alt+shift+space
JARVIS_VOICE_HOTKEY=alt+shift+v
JARVIS_VOICE=false
JARVIS_VOICE_LANGUAGE=ru
JARVIS_STREAM=true
JARVIS_TRAY=true
JARVIS_SKILLS_DIRS=~/.jarvis/skills,./skills

# -- answer cache ----------------------------------------------------------
# Identical questions are answered from a local SQLite cache. Replies that
# call a tool are never cached.
JARVIS_CACHE=true
JARVIS_CACHE_PATH=~/.jarvis/cache.db
JARVIS_CACHE_TTL=86400

# -- retrieval over your own documents -------------------------------------
# Index folders with: jarvis --index "C:/Users/you/Documents"
JARVIS_RAG=false
JARVIS_RAG_PATH=~/.jarvis/documents.db
JARVIS_RAG_ROOTS=

# -- planner ---------------------------------------------------------------
# A cheap model drafts the steps before the main model starts working.
JARVIS_PLANNER=false
JARVIS_PLANNER_PROVIDER=

# -- browser interface -----------------------------------------------------
# jarvis --web opens a local chat page. Anything that can reach this port can
# run commands as you, so keep the host on loopback.
JARVIS_WEB=false
JARVIS_WEB_HOST=127.0.0.1
JARVIS_WEB_PORT=8765
# Empty means a fresh token is generated at every start.
JARVIS_WEB_TOKEN=

# -- reliability -----------------------------------------------------------
# Outbound HTTP calls are retried with exponential backoff.
JARVIS_RETRY_ATTEMPTS=3
JARVIS_RETRY_BASE_DELAY=1.0
# Longest tool result handed back to the model, in characters.
JARVIS_MAX_TOOL_RESULT=20000

# -- cost control ----------------------------------------------------------
# Warn at 80% of the daily budget, refuse paid calls at 100%. Empty = no limit.
JARVIS_BUDGET_DAILY_USD=
JARVIS_USAGE_LOG=~/.jarvis/usage.json
# Override the built-in price table: JARVIS_PRICES=model:in_per_1k:out_per_1k,...
JARVIS_PRICES=

# -- windows ---------------------------------------------------------------
# Full path to powershell.exe or pwsh.exe when it is not on PATH.
JARVIS_POWERSHELL=
# Application id shown on toast notifications.
JARVIS_TOAST_APP_ID=

# -- telegram --------------------------------------------------------------
JARVIS_TELEGRAM=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
