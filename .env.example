# --- Provider selection -------------------------------------------------
# openai | anthropic | ollama | custom | any name from config.yaml
JARVIS_BACKEND=openai

# --- Built-in providers -------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- Any custom / OpenAI-compatible API ---------------------------------
# Set JARVIS_BACKEND=custom to use these.
# JARVIS_API_KIND=openai
# JARVIS_API_BASE=https://openrouter.ai/api/v1
# JARVIS_API_KEY=
# JARVIS_MODEL=deepseek/deepseek-chat

# --- Behaviour ----------------------------------------------------------
JARVIS_REQUIRE_CONFIRMATION=true
JARVIS_MAX_ITERATIONS=12
# JARVIS_PERSONA=Answer briefly and in Russian.

# --- Capability kill switches -------------------------------------------
JARVIS_ALLOW_SHELL=true
JARVIS_ALLOW_EXEC=true
JARVIS_ALLOW_DESKTOP=true
JARVIS_ALLOW_APP_MANAGEMENT=false
JARVIS_ALLOW_NETWORK=true
# Comma-separated sandbox roots; empty means the whole filesystem.
# JARVIS_ALLOWED_ROOTS=~/projects,~/Documents
JARVIS_AUDIT_LOG=~/.jarvis/audit.log

# --- Interfaces ---------------------------------------------------------
JARVIS_HOTKEY=ctrl+alt+space
JARVIS_VOICE_HOTKEY=ctrl+alt+v
JARVIS_VOICE=false
JARVIS_VOICE_LANGUAGE=ru
# JARVIS_SKILLS_DIRS=~/.jarvis/skills,./skills
