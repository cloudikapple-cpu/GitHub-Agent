# Copy to .env and fill in what you use. Everything here is optional.

# -- provider selection --------------------------------------------------
JARVIS_BACKEND=openai
# Fully custom endpoint without touching config.yaml:
# JARVIS_BACKEND=custom
# JARVIS_API_KIND=openai
# JARVIS_API_BASE=https://your-gateway.example.com/v1
# JARVIS_API_KEY=...
# JARVIS_MODEL=your-model

# -- built-in providers ---------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1

# NVIDIA NIM (OpenAI-compatible cloud fallback for a local model)
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# -- routing: local model first, cloud rescue ------------------------------
JARVIS_ROUTER=false
JARVIS_ROUTER_PRIMARY=ollama
JARVIS_ROUTER_FALLBACKS=nim
JARVIS_ROUTER_HEAVY=nim

# -- internet --------------------------------------------------------------
TAVILY_API_KEY=
JARVIS_SEARCH_PROVIDER=auto

# -- capabilities (kill switches) -----------------------------------------
JARVIS_ALLOW_SHELL=true
JARVIS_ALLOW_EXEC=true
JARVIS_ALLOW_DESKTOP=true
JARVIS_ALLOW_APP_MANAGEMENT=false
JARVIS_ALLOW_NETWORK=true
JARVIS_ALLOWED_ROOTS=
JARVIS_AUDIT_LOG=~/.jarvis/audit.log
JARVIS_DRY_RUN=false
JARVIS_SANDBOX=none

# -- subsystems ------------------------------------------------------------
JARVIS_KNOWLEDGE=true
JARVIS_SCHEDULER=true
JARVIS_HOTKEY=ctrl+alt+space
JARVIS_VOICE_HOTKEY=ctrl+alt+v
JARVIS_VOICE=false
JARVIS_VOICE_LANGUAGE=ru
JARVIS_SKILLS_DIRS=~/.jarvis/skills,./skills

# -- telegram --------------------------------------------------------------
JARVIS_TELEGRAM=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
