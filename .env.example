# Copy this file to .env and fill in the values you need.
# The assistant reads these at startup. Never commit your real .env file.

# Which LLM backend to use: openai | anthropic | ollama
JARVIS_BACKEND=openai

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Anthropic ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# --- Ollama (local model) ---
# Start Ollama with `ollama serve` and pull a model, e.g. `ollama pull llama3.1`
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- Behaviour ---
# Allow the assistant to run shell commands (true/false)
JARVIS_ALLOW_SHELL=true
# Ask for confirmation in the terminal before running shell / python / desktop actions (true/false)
JARVIS_REQUIRE_CONFIRMATION=true
# Max tool-calling iterations per user request
JARVIS_MAX_ITERATIONS=12
